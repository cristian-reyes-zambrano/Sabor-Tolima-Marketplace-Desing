# ─────────────────────────────────────────────────────────────────────────────
# Sabor Tolima Marketplace — Variables de entorno
# Copia este archivo a .env.local y completa con tus valores reales de Firebase
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Maps ──────────────────────────────────────────────────────────────
# Obtén tu API Key en: https://console.cloud.google.com → APIs & Services → Credentials
# Habilita: Maps JavaScript API + Directions API + Places API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Cómo obtener estos valores ───────────────────────────────────────────────
# 1. Ve a https://console.firebase.google.com
# 2. Selecciona tu proyecto → Configuración del proyecto (⚙️)
# 3. En "Tus apps" copia el objeto firebaseConfig
# 4. Pega cada valor en las variables de arriba
#
# Servicios que debes habilitar en Firebase Console:
#   ✅ Authentication → Email/Password
#   ✅ Firestore Database (modo producción)
#   ✅ Storage
#   ✅ Analytics (opcional)
# ─────────────────────────────────────────────────────────────────────────────
